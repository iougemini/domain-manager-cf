# Domain Manager - Git Attributes 配置

# ============================================
# 自动检测文本文件并进行换行符标准化
# ============================================
* text=auto

# ============================================
# 源代码文件
# ============================================
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf

# ============================================
# 文档文件
# ============================================
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
README text eol=lf

# ============================================
# 配置文件
# ============================================
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# ============================================
# Shell 脚本
# ============================================
*.sh text eol=lf
*.bash text eol=lf

# ============================================
# 批处理脚本
# ============================================
*.bat text eol=crlf
*.cmd text eol=crlf

# ============================================
# 图片文件（二进制）
# ============================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# ============================================
# 字体文件（二进制）
# ============================================
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# ============================================
# 压缩文件（二进制）
# ============================================
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# ============================================
# Git LFS（如果使用大文件存储）
# ============================================
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text

# ============================================
# 语言统计（GitHub Linguist）
# ============================================
# 排除某些文件不计入项目语言统计
*.md linguist-documentation
LICENSE linguist-documentation
